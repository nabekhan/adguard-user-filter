{
  "title": "Personal DNS Filters",
  "description": "Lists of DNS filters for various websites and services.",
  "homepage": "https://nabekhan.github.io/filters-userscripts/",
  "expires": "1 week",
  "lists": {
    "siri-ai-enable": {
      "category": "other",
      "enabled": true,
      "target": "icloud",
      "source": "icloud/siri-ai-enable.txt"
    },
    "adguard-sdns-filter": {
      "category": "privacy",
      "enabled": true,
      "target": "global",
      "source": "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt"
    },
    "hagezi-pro": {
      "category": "privacy",
      "enabled": true,
      "excludePlatforms": ["mobile"],
      "target": "global",
      "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.txt"
    },
    "hagezi-pro-mini": {
      "category": "privacy",
      "enabled": true,
      "platforms": ["mobile"],
      "target": "global",
      "source": "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.mini.txt"
    },
    "hagezi-tif-medium": {
      "category": "security",
      "enabled": true,
      "platforms": ["desktop"],
      "target": "global",
      "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.medium.txt"
    },
    "hagezi-tif-mini": {
      "category": "security",
      "enabled": true,
      "platforms": ["mobile", "server"],
      "target": "global",
      "source": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.mini.txt"
    }
  }
}
