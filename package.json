{
  "name": "user-filter-scripts",
  "private": true,
  "version": "0.1.0",
  "description": "Modular AdGuard filter subscriptions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "prebuild": "npm run format:check",
    "build": "node scripts/build.mjs",
    "format": "node scripts/format-config.mjs && prettier --write . --ignore-unknown",
    "format:check": "node scripts/format-config.mjs --check && prettier --check . --ignore-unknown",
    "resolve-configs": "node scripts/resolve-configs.mjs",
    "validate": "npm run resolve-configs && npm run build && npx aglint"
  },
  "dependencies": {
    "@adguard/filters-compiler": "3.3.0"
  },
  "devDependencies": {
    "@adguard/aglint": "3.0.3",
    "prettier": "3.9.6"
  }
}
