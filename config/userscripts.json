{
  "title": "Userscripts",
  "description": "Commonly used userscripts for various websites.",
  "homepage": "https://github.com/nabekhan/filters-userscripts",
  "requires": "userscript-installer",
  "scripts": {
    "dont-track-me-google": {
      "category": "tools",
      "enabled": true,
      "target": "google",
      "source": "https://update.greasyfork.org/scripts/428243/Don%27t%20track%20me%20Google.user.js"
    },
    "old-reddit": {
      "category": "tools",
      "enabled": true,
      "target": "reddit",
      "source": "https://update.greasyfork.org/scripts/423965/Good%20o%27l%20Reddit.user.js"
    },
    "autocomplete-deck": {
      "category": "tools",
      "enabled": true,
      "target": "ucalgary",
      "source": "https://update.greasyfork.org/scripts/527303/Auto%20Complete%20Deck.user.js"
    },
    "sb-js-userscript": {
      "category": "nuisances",
      "enabled": true,
      "target": "youtube",
      "source": "https://raw.githubusercontent.com/mchangrh/sb.js/main/docs/sb.user.js"
    },
    "youtube-safari-pip": {
      "category": "tools",
      "enabled": true,
      "platforms": ["ios"],
      "target": "youtube",
      "source": "https://update.greasyfork.org/scripts/525416/YouTube%20Safari%20iOS%20PiP%20Block%20Unblocker.user.js"
    },
    "grocery-price-per-unit": {
      "category": "shopping",
      "enabled": true,
      "target": "global",
      "source": "https://github.com/nabekhan/grocery-price-per-unit/releases/latest/download/Grocery-Price-Per-Unit.user.js"
    },
    "base64-autodecode": {
      "category": "tools",
      "enabled": true,
      "target": "global",
      "source": "https://update.greasyfork.org/scripts/485772/FMHY%20Base64%20Auto%20Decoder.user.js"
    },
    "userscript-installer": {
      "category": "tools",
      "enabled": true,
      "target": "global",
      "source": "global/tools/userscript-installer.user.js"
    }
  }
}
