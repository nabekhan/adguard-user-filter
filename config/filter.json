{
  "title": "AdGuard filter",
  "description": "Lists compiled for supported platforms.",
  "homepage": "https://github.com/nabekhan/user-filter-scripts",
  "expires": "1 week",
  "lists": {
    "siri-ai-enable": {
      "category": "other",
      "enabled": true,
      "file": "icloud/other/siri-ai-enable.txt",
